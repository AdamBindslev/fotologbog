# Tillad kun visning af billeder, og forhindr afvikling af scripts
Options -Indexes -ExecCGI

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
