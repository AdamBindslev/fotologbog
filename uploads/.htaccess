# Forhindr afvikling af scripts i uploads-mappen
<FilesMatch "\.(php|phtml|phar|php3|php4|php5|php7|php8|phps|cgi|pl|py|sh|shtml|html|htm|svg)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
