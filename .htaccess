# Logbog Apache Konfiguration til Gigahost
Options -Indexes
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Beskyt følsomme filer og mapper
    RewriteRule ^data/ - [F,L]
    RewriteRule \.(db|sqlite|sqlite3|env|git.*|md)$ - [F,L]

    # Venlige genveje
    RewriteRule ^(skriv|admin)/?$ app/ [R=301,L]
    RewriteRule ^(feed|feed\.xml|rss)/?$ rss.php [L]
    RewriteRule ^post/([0-9]+)/?$ post.php?id=$1 [L,QSA]
</IfModule>

# Caching og komprimering
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
